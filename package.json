    "type": "git",
    "url": "git+https://github.com/foliokit/addon-wheel-strategy.git"
  },
  "bugs": {
    "url": "https://github.com/foliokit/addon-wheel-strategy/issues"
  },
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "dev:server": "wealthfolio-addon dev",
    "clean": "rimraf dist",
    "package": "node scripts/package.mjs",
    "bundle": "npm run clean && npm run build && npm run package",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit"
  },
